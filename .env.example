# Comma-separated pool of LLM provider API keys (at least 2). Ids become key_1, key_2, ...
LLM_API_KEYS=your_gemini_key_1_here,your_gemini_key_2_here
# LiteLLM model name used for every request
LLM_MODEL=gemini/gemini-2.5-flash
# SQLite location (inside the Docker named volume mounted at /data)
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test header
ENABLE_FAILURE_SIMULATION=true
# Frontend only (build time): public URL of the backend
VITE_API_URL=http://localhost:8000
